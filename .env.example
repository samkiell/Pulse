# ==============================================================================
# Pulse Environment Configuration Template
# Grouped by service. Markings indicate variables required for minimal deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# REQUIRED. PostgreSQL connection string (Rumpty Managed DB or local Postgres).
# For Rumpty Managed Postgres with SSL, append ?sslmode=require
DATABASE_URL="postgresql://pulse:pulsepassword@localhost:5432/pulsedb?schema=public"

# ------------------------------------------------------------------------------
# Pulse API
# ------------------------------------------------------------------------------
# REQUIRED. Public HTTPS URL where the Pulse API is reachable on the internet.
PUBLIC_API_URL="https://api.yourdomain.com"

# Port on which the API listens (defaults to 3001).
PORT=3001

# Operational environment: "production" or "development".
NODE_ENV="production"

# Debounce window in minutes for recurring incidents (default: 5).
ALERT_DEBOUNCE_WINDOW_MINUTES=5

# Comma-separated list of allowed origins for dashboard CORS.
CORS_ORIGINS="https://dashboard.yourdomain.com,http://localhost:3000"

# Retention period in days for error events (default: 30).
RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# Pulse Web / Dashboard
# ------------------------------------------------------------------------------
# REQUIRED in production. HTTP Basic Auth password for dashboard access.
DASHBOARD_PASSWORD="replace_with_a_secure_password"

# HTTP Basic Auth username (default: "admin").
DASHBOARD_USER="admin"

# Port on which the Web dashboard listens (defaults to 3000).
PORT=3000

# Public URL of the web dashboard.
DASHBOARD_URL="https://dashboard.yourdomain.com"
NEXT_PUBLIC_APP_URL="https://dashboard.yourdomain.com"

# Internal URL used by the web app to proxy API requests in container networks.
INTERNAL_API_URL="http://localhost:3001"

# Internal URL used by the dashboard simulator to dispatch ingest payloads.
INTERNAL_INGEST_URL="http://localhost:3001/api/v1/ingest"

# ------------------------------------------------------------------------------
# AI Inference
# ------------------------------------------------------------------------------
# Primary inference endpoint (Rumpty Cloud OpenAI-compatible endpoint).
RUMPTY_AI_ENDPOINT="https://chat.rumptycloud.com/v1/chat/completions"

# Primary Rumpty AI API key (leave empty to use heuristic analysis).
RUMPTY_AI_API_KEY=""

# Model name for primary inference (query GET /v1/models to list available models).
RUMPTY_AI_MODEL=""

# Optional secondary fallback LLM endpoint (e.g. Groq, Together, OpenAI).
AI_FALLBACK_ENDPOINT=""
AI_FALLBACK_API_KEY=""
AI_FALLBACK_MODEL=""

# ------------------------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------------------------
# REQUIRED for Telegram notifications. Bot token provided by @BotFather.
TELEGRAM_BOT_TOKEN=""

# Bot username without @ prefix (used to generate chat link deep links).
TELEGRAM_BOT_USERNAME="PulseMonitorBot"

# REQUIRED in production. Secret token used to verify Telegram webhook requests.
# Header X-Telegram-Bot-Api-Secret-Token must match this value.
TELEGRAM_WEBHOOK_SECRET="replace_with_a_random_secret_token"

# Base URL for Telegram Bot API (default: https://api.telegram.org).
TELEGRAM_API_BASE="https://api.telegram.org"
