# Database (Rumpty Managed DB or local Postgres)
DATABASE_URL="postgresql://pulse:pulsepassword@localhost:5432/pulsedb?schema=public"
DATABASE_URL_TEST="postgresql://pulse:pulsepassword@localhost:5432/pulsedb_test?schema=public"

# Auth (NextAuth v5 / GitHub OAuth)
# Generate with `openssl rand -base64 32`
AUTH_SECRET="your-32-character-secret-key-goes-here"
# GitHub OAuth App credentials
AUTH_GITHUB_ID="github_oauth_client_id"
AUTH_GITHUB_SECRET="github_oauth_client_secret"
# Public base URL of the web application (e.g. http://localhost:3000 or https://pulse.yourdomain.com)
APP_URL="http://localhost:3000"

# Project limits
MAX_PROJECTS_PER_USER=5

# Internal API Secret for secure simulator calls between Web and API
INTERNAL_API_SECRET="your-internal-api-secret-key"

# API Port & Ingest Settings
PORT=4000
API_PORT=4000
NODE_ENV=development
ALERT_DEBOUNCE_WINDOW_MINUTES=5

# Rumpty AI Inference Endpoint (OpenAI compatible)
RUMPTY_AI_ENDPOINT="https://api.rumpty.cloud/v1/chat/completions"
RUMPTY_AI_API_KEY=""
RUMPTY_AI_MODEL="rumpty-llama-3-70b-instruct"

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="PulseMonitorBot"
TELEGRAM_WEBHOOK_SECRET=""

# Web Dashboard & Ingest URLs
DASHBOARD_URL="http://localhost:3000"
INTERNAL_API_URL="http://localhost:4000"
INTERNAL_INGEST_URL="http://localhost:4000/api/v1/ingest"
