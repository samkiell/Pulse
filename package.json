{
  "name": "pulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "test": "pnpm --filter pulse-monitor test && pnpm --filter @pulse/api test",
    "db:generate": "pnpm --filter @pulse/db generate",
    "db:push": "pnpm --filter @pulse/db push"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
